# Engine settings (all optional; /lotnok sets token, key and treasury)
PORT=5023
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The cycle: escrow size (ETH) that triggers each step, in order feeding (reward) → burn → keeper (treasury) → feeding …
# With these three, one full loop is 40% to holders, 40% burned, 20% to the treasury.
FEEDING_ETH=0.02
BURN_ETH=0.02
KEEPER_ETH=0.01
# Percent of every feeding that goes to the spark: the wallet that bought the most since the last
# feeding and has not moved it on. 0 switches the spark off and the top N share the whole feeding.
SPARK_PCT=25
# A burn buy may land this far (percent) below the curve's quote before it reverts
BURN_SLIPPAGE_PCT=5
# The rest of a feeding goes to this many sitters, biggest balances first, split by balance
FEEDING_TOP_N=10
# Tiers inside the top N, "upTo:percent": No. 1–5 share 70% of the ten's part, No. 6–10 share 30%, by balance within each
FEEDING_TIERS=5:70,10:30
MIN_BALANCE=100000
# First $URN must be this old (hours) to be in the top N; stops buying in right before a claim.
# The spark ignores this on purpose: buying this round is how it is won.
MIN_HOLD_HOURS=0
CONTRACTS_ARE_SELLS=1
# Pool addresses, comma separated (e.g. the Uniswap v4 PoolManager after graduation). Tokens sent
# to them count as a sell; tokens coming from them count as a buy for the spark.
SELL_SINKS=
# needed only to change token/key/treasury after they are set
ADMIN_SECRET=
# Connect X (optional). An X developer app, type "Web App", callback <SITE_URL>/api/x/callback.
# Leave empty and the "Connect X" button stays hidden.
SITE_URL=https://your-domain.example
X_CLIENT_ID=
X_CLIENT_SECRET=
# 1 lets the demo edition try a real X sign-in (nothing saved). scripts/site-mode.sh sets it.
X_DEMO=0

# How often the engine reads new blocks (seconds). 3 keeps the register live.
POLL_INTERVAL_SECONDS=3
